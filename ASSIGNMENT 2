Encapsulation is the bundling data (attributes) and the methods that work on it
inside one class, and restricting direct access to the data. In Python this
is done with naming conventions:
  - _name   : protected (convention only, "please don't touch")
  - __name  : private (name mangling -> _ClassName__name, not accessible
              directly from outside the class)
Outside code must go through public methods, which can validate input.
"""

class BankAccount:
    def __init__(self, owner, initial_balance=0):
        self.owner = owner
        self.__balance = 0            # private attribute
        if initial_balance > 0:
            self.__balance = initial_balance

    def deposit(self, amount):
        if amount <= 0:
            print("Deposit must be positive.")
            return
        self.__balance += amount
        print(f"Deposited {amount}. ")

    def withdraw(self, amount):
        if amount <= 0:
            print("Withdrawal must be positive.")
        elif amount > self.__balance:
            print("Insufficient funds.")
        else:
            self.__balance -= amount
            print(f"Withdrew {amount}.")

    def display_balance(self):
        print(f"{self.owner}'s balance: {self.__balance}")


# ---- Demonstration ----
acct = BankAccount("Prince", 1000)
acct.display_balance()
acct.deposit(500)
acct.withdraw(200)
acct.withdraw(5000)          # rejected by validation
acct.display_balance()

# Direct access to the private attribute fails:
try:
    print(acct.__balance)
except AttributeError as e:
    print("Direct access blocked:", e)

# Setting acct.__balance from outside just creates a NEW unrelated attribute;
# the real balance is untouched:
acct.__balance = 999999
acct.display_balance()       # still the real balance

# (Name mangling means it's technically reachable as below, but this is
# strongly discouraged - it shows privacy in Python is by convention.)
print("Mangled name:", acct._BankAccount__balance)



