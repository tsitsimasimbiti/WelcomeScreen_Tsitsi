import sqlite3

conn = None
try:
    # Connect (creates students.db if it doesn't exist)
    conn = sqlite3.connect("students.db")
    cur = conn.cursor()

    # Create table
    cur.execute("""
        CREATE TABLE IF NOT EXISTS students (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            age INTEGER,
            course TEXT
        )
    """)

    # Clear old rows so re-running doesn't duplicate data
    cur.execute("DELETE FROM students")

    # Insert data
    students = [
        ("Alice", 20, "Computer Science"),
        ("Bob", 22, "Information Systems"),
        ("Carol", 21, "Software Engineering"),
    ]
    cur.executemany("INSERT INTO students (name, age, course) VALUES (?, ?, ?)", students)
    conn.commit()

    # Retrieve data
    cur.execute("SELECT id, name, age, course FROM students")
    for row in cur.fetchall():
        print(row)

except sqlite3.Error as e:
    print("Database error:", e)
finally:
    if conn:
        conn.close()



